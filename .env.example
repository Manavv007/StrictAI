# Copy to .env and fill in your key. Never commit .env.
GROQ_API_KEY=your_groq_api_key_here

# Interview LLM (candidate-facing replies)
GROQ_MODEL=llama-3.1-8b-instant

# Cheap model used ONLY by NeMo guardrails rails (Task 4+)
GROQ_RAIL_MODEL=llama-3.1-8b-instant

# Fail modes (Task 4+): input fails open, output fails closed
GUARDRAILS_FAIL_OPEN_INPUT=true
GUARDRAILS_FAIL_CLOSED_OUTPUT=true
